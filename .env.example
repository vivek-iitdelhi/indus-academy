# Public URL of the deployed site, used for metadata, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://indusai.academy

# Contact-form enquiries are emailed through Resend (https://resend.com).
# In development, enquiries are logged to the server console when RESEND_API_KEY is unset.
RESEND_API_KEY=
# Inbox(es) that receive enquiries, comma-separated. Defaults to the site email.
ENQUIRY_TO_EMAIL=hello@indusai.academy
# Must be on a domain verified in Resend. Before verification, use "Indus AI Academy <onboarding@resend.dev>",
# which can only deliver to the email address on your Resend account.
ENQUIRY_FROM_EMAIL="Indus AI Academy <enquiries@indusai.academy>"

# Newsletter: subscribers live in a Resend segment; the daily cron emails them new articles.
# Create the segment in Resend (Audiences -> Segments) and paste its id here.
RESEND_SEGMENT_ID=
# Sender for confirmation emails and the daily digest.
NEWSLETTER_FROM="Indus AI Academy <newsletter@indusai.academy>"
# Signs the double opt-in confirmation links. Any long random string; keep it secret.
NEWSLETTER_SECRET=
# Vercel sends this as "Authorization: Bearer <value>" on scheduled cron requests.
CRON_SECRET=

# Razorpay, for program seats and course purchases. Add both, then redeploy:
# the "Reserve your seat" button only appears in builds where these are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- LMS ---------------------------------------------------------------------
# Postgres. In production, the Supabase pooler URL in transaction mode (port 6543); the
# client disables prepared statements for it. Locally: postgres://localhost/indus_lms
DATABASE_URL=
# Better Auth: signs sessions. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Better Auth: this deployment's origin, e.g. https://indusai.academy or http://localhost:3000.
BETTER_AUTH_URL=
# Google sign-in. Optional; the button only appears when both are set.
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails that can open /admin.
ADMIN_EMAILS=
# Signs certificate hashes. Long random string; never rotate once certificates exist.
CERTIFICATE_SECRET=
# Numeric id of the LinkedIn company page, for "Add to LinkedIn"; unset falls back to the company name.
LINKEDIN_ORGANIZATION_ID=
# Cloudflare Stream: account id, and an API token with Stream:Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
# The <CODE> in https://customer-<CODE>.cloudflarestream.com.
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# From POST /accounts/<id>/stream/keys: the key `id`, and its `pem` (or `jwk`) exactly as returned (base64).
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=
